# YouTube Publisher Configuration Example
# Copy this file to .env and customize the values as needed
# WARNING: Never commit the actual .env file to version control!

# ============================================================================
# Google Sheets Configuration (Metadata Source)
# ============================================================================

# The Google Sheets document ID from the URL
# Example: https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
GOOGLE_SHEETS_ID=your_spreadsheet_id_here

# Sheet name and range to read from
# Format: SheetName!StartColumn:EndColumn
GOOGLE_SHEETS_RANGE=Videos!A:Z

# Status value to filter tasks for processing
# Tasks with this status will be processed
SHEETS_READY_STATUS=READY

# Google Service Account Credentials
# Path to the service account JSON file for Google Sheets API access
# Download from Google Cloud Console > IAM & Admin > Service Accounts
# Share your Google Sheet with the service account email
GOOGLE_APPLICATION_CREDENTIALS=service_account.json

# ============================================================================
# YouTube API Configuration
# ============================================================================

# Path to OAuth2 client secrets JSON file
# Download from Google Cloud Console > APIs & Services > Credentials
# Create OAuth 2.0 Client ID (Application type: Desktop app)
YOUTUBE_CLIENT_SECRETS_FILE=client_secrets.json

# Path to store YouTube OAuth2 token (created automatically after first auth)
YOUTUBE_TOKEN_FILE=.data/youtube_token.pickle

# ============================================================================
# Storage Configuration
# ============================================================================

# Base directory for video files (absolute or relative paths)
# If not set, uses current working directory
STORAGE_BASE_PATH=

# Directory for IN_PROGRESS stage files (created if doesn't exist)
# When a task starts processing, the media file is moved here
# Example: .data/in_progress or /path/to/in_progress
MEDIA_IN_PROGRESS_DIR=.data/in_progress

# Directory for UPLOADED stage files (created if doesn't exist)
# After successful upload, the media file is moved here
# Example: .data/uploaded or /path/to/uploaded
MEDIA_UPLOADED_DIR=.data/uploaded

# ============================================================================
# Application Configuration
# ============================================================================
